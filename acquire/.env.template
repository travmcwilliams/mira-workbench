# Copy to .env (never commit .env). Every value is optional.

# DuckDB location for the canonical `records` table
APP_PROJECT_ROOT=/path/to/mira/acquire
APP_DB_PATH=/path/to/mira/acquire/db/app.duckdb

# Optional providers
SERPER_API_KEY=

# Identify your crawler to publishers (include a contact URL or email)
MIRA_USER_AGENT=
MIRA_CRAWLER_CONTACT=
