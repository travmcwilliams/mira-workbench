# Acquire runtime data
acquire/db/*.duckdb
acquire/db/*.duckdb.wal
acquire/data/raw/
# Scraper run telemetry: RunLogger rewrites this whole file on every event, so
# it churns thousands of diff lines per run, embeds machine-local absolute paths
# and temp dirs, and re-serializes (and has once corrupted) older entries.
# RunLogger._load treats a missing file as an empty log, so a clone needs none.
acquire/data/scraper_run_log.json
.env
.venv/
.venv311/

