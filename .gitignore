.pytest_tmp/

# Prediction-market probe data - regenerable, multi-hundred-MB CSVs (exceed GitHub limits)
data/predmarkets/

# Browser sessions / cookies
.session/

# Regenerable scrape dumps (rebuild via acquire.crawlers.*). Not source.
data/scout/
data/ocr_cache/

# --- Data safety net -------------------------------------------------------
# Everything under data/ is ignored by default. Only small, synthetic or public
# samples are allow-listed below; add new ones explicitly and on purpose.
data/*
!data/sample/
!data/study/
!data/earnings/
data/sample/*
!data/sample/boston_sample.csv
!data/sample/restaurant_daily_sample.csv
!data/sample/restaurant_labor_sample.csv
!data/sample/news_ticker_study_narrow.csv
!data/sample/news_ticker_study_narrow_model.csv
!data/sample/stock_daily_features.csv

